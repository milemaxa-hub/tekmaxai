---
// Reading progress bar — fixed na vrhu, prati scroll kroz article.
// Takođe računa procenat pročitanosti i prikazuje ga.

interface Props {
  targetSelector?: string; // element čija visina se prati (default = ceo article)
}

const { targetSelector = 'article' } = Astro.props;
---

<!-- Reading progress bar (fiksiran na vrhu) -->
<div
  id="reading-progress"
  class="fixed left-0 top-0 z-50 h-1 w-0 bg-accent transition-[width] duration-150"
  role="progressbar"
  aria-label="Progres čitanja"
></div>

<!-- Procenat pročitanosti (fiksiran desno-dole, mali floating widget) -->
<div
  id="reading-percent"
  class="fixed bottom-6 left-6 z-40 hidden items-center gap-2 rounded-full border border-line-subtle bg-bg-secondary/90 px-3 py-2 text-caption shadow-lg backdrop-blur"
>
  <svg class="h-4 w-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.232 5.477 3 6.253v13C4.232 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.752 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
  </svg>
  <span class="font-semibold text-ink-primary" id="reading-percent-value">0%</span>
  <span class="text-ink-tertiary">pročitano</span>
</div>

<script is:inline define:vars={{ targetSelector }}>
  (function () {
    var bar = document.getElementById('reading-progress');
    var percentEl = document.getElementById('reading-percent');
    var percentValueEl = document.getElementById('reading-percent-value');
    var target = document.querySelector(targetSelector);
    if (!bar || !target) return;

    function update() {
      var rect = target.getBoundingClientRect();
      var targetTop = rect.top + window.scrollY;
      var targetHeight = target.offsetHeight;
      var viewport = window.innerHeight;
      var scrollY = window.scrollY;

      // Počni kada vrh article-a stigne do vrha viewport-a
      var start = targetTop;
      // Završi kada dno article-a stigne do dna viewport-a
      var end = targetTop + targetHeight - viewport;

      if (end <= start) {
        // Članak je kraći od viewport-a — odmah 100%
        bar.style.width = '100%';
        if (percentEl) {
          percentEl.classList.remove('hidden');
          percentEl.classList.add('flex');
          percentValueEl.textContent = '100%';
        }
        return;
      }

      var percent = Math.max(0, Math.min(100, ((scrollY - start) / (end - start)) * 100));
      bar.style.width = percent + '%';

      if (percentEl) {
        if (percent > 5) {
          percentEl.classList.remove('hidden');
          percentEl.classList.add('flex');
        } else {
          percentEl.classList.add('hidden');
          percentEl.classList.remove('flex');
        }
        percentValueEl.textContent = Math.round(percent) + '%';
      }
    }

    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
    update();
  })();
</script>
