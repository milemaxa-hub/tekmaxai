---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const articles = await getCollection('vesti');

const tagCount = new Map<string, number>();
for (const article of articles) {
  for (const tag of article.data.tags ?? []) {
    tagCount.set(tag, (tagCount.get(tag) ?? 0) + 1);
  }
}

const tags = Array.from(tagCount.entries())
  .sort((a, b) => b[1] - a[1]) // najčešći prvo
  .map(([display, count]) => ({
    display,
    count,
    slug: display
      .toLowerCase()
      .replace(/č/g, 'c')
      .replace(/ć/g, 'c')
      .replace(/š/g, 's')
      .replace(/ž/g, 'z')
      .replace(/đ/g, 'dj')
      .replace(/\s+/g, '-')
      .replace(/[^\w-]/g, ''),
  }));
---

<Layout
  title="Tagovi — Tekmax"
  description="Svi Tekmax tagovi — pretraži članke po temi."
>
  <section class="container-page py-10">
    <nav class="mb-4 text-body-sm text-ink-tertiary">
      <a href="/" class="link-hover">Početna</a>
      <span class="mx-2">/</span>
      <span class="text-ink-primary">Tagovi</span>
    </nav>

    <h1 class="text-h1 font-extrabold">Svi tagovi</h1>
    <p class="mt-3 text-body-lg text-ink-secondary">
      {tags.length} {tags.length === 1 ? 'tag' : tags.length < 5 ? 'taga' : 'tagova'} iz {articles.length} članaka
    </p>

    <div class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4">
      {tags.map((tag) => (
        <a
          href={`/tag/${tag.slug}`}
          class="group flex items-center justify-between gap-2 rounded-lg border border-line-subtle bg-bg-secondary px-4 py-3 transition-all hover:border-accent"
        >
          <span class="truncate font-bold text-ink-primary group-hover:text-accent">#{tag.display}</span>
          <span class="shrink-0 rounded-md bg-accent/10 px-2 py-0.5 text-caption font-semibold text-accent">
            {tag.count}
          </span>
        </a>
      ))}
    </div>
  </section>
</Layout>
